# Configuração do Firebase no frontend (opcional).
# Sem VITE_FIREBASE_PROJECT_ID, o app usa o projeto de produção (whiskerworld-ea08d).
# Com ela, TODOS os valores abaixo são lidos daqui (sem misturar com produção).
# No preview da Vercel, preencha com os valores do projeto Firebase de testes.
# MEASUREMENT_ID é opcional: sem ele, o Analytics fica desligado.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
