# JWT
JWT_SECRET=coloque_uma_chave_secreta_forte_aqui

# Firebase Admin SDK
# Cole aqui o conteúdo do JSON da Service Account (em uma linha só, sem quebras)
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"whiskerworld-ea08d",...}

# Firebase Storage Bucket (já preenchido com o valor do seu projeto)
FIREBASE_STORAGE_BUCKET=whiskerworld-ea08d.firebasestorage.app

# Chave web do Firebase usada no login do dashboard /docs.
# Opcional: sem ela, usa a chave do projeto de produção. No preview da Vercel,
# use a chave do projeto Firebase de testes.
FIREBASE_WEB_API_KEY=
